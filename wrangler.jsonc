{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maze-generator",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "main": "./src/index.js"
  "assets": {
    "directory": "./publish-output/wwwroot",
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
