@using MazeGame.Models.Generation
@using MazeGame.Models.Algorithms
@using MazeGame.Models.Structure
@page "/"
<PageTitle>Maze</PageTitle>

<div class="app-wrapper">
    <div class="info">

        <div class="panel instructions">
            <h2 class="section-title">Instructions</h2>
            <p>
                Hold left click to place.
                <br />
                Only one start and end position can be placed.
            </p>
        </div>

        <div class="panel maze-controls">
            <h3 class="section-title">Maze Controls</h3>

            <div class="menu-section">
                <div class="input-group">
                    <label for="maze-row">Rows</label>
                    <input id="maze-row" type="range" min="5" max="30" @bind="_maze.Rows" @bind:event="oninput" disabled="@_isSolving" />
                    <p>@_maze.Rows</p>
                </div>
                <div class="input-group">
                    <label for="maze-column">Columns</label>
                    <input id="maze-column" type="range" min="5" max="30" @bind="_maze.Columns" @bind:event="oninput" disabled="@_isSolving" />
                    <p>@_maze.Columns</p>
                </div>
            </div>

            <div class="menu-section">
                <h5>Current Active Placement</h5>
                <div class="maze-input">
                    @foreach (MazeCell mazeCell in Enum.GetValues<MazeCell>())
                    {
                        <button class="selection-button @(mazeCell == _activeMazeCell ? "active" : "")" @onclick="() => SetActiveCell(mazeCell)">@Enum.GetName(mazeCell)</button>
                    }
                </div>
            </div>

            <div class="menu-section action-buttons">
                <button class="clear-button" @onclick="@Clear">Clear maze</button>
                <button class="solve-button" @onclick="@StartSolve" disabled="@(_isSolving || !StartExists() || !EndExists())">Solve</button>
                <button class="skip-button" @onclick="@SkipAnimation" disabled="@(!_isSolving || _skipAnimation)">Skip</button>
                <button class="stop-button" @onclick="@StopSolve" disabled="@(!_isSolving)">Stop</button>
            </div>

            <div class="menu-section">
                <button class="solve-button" @onclick="GenerateMaze">Generate Random Maze</button>
            </div>
        </div>

        <details class="panel optimization-settings">
            <summary>
                <h3 class="section-title inline">Optimization Settings</h3>
                <p class="description">Edit these if the animations look bad or choppy.</p>
            </summary>

            <div class="menu-section">
                <div class="input-group">
                    <label for="batch-size">Batch size</label>
                    <p class="description">Affects how often the screen is re-rendered. Lower this if it looks laggy.</p>
                    <input id="batch-size" type="range" min="1" max="20" @bind="_batchSize" @bind:event="oninput"/>
                    <p>@_batchSize</p>
                </div>

                <div class="input-group">
                    <label for="animation-speed">Animation speed</label>
                    <p class="description">Delay (ms) between rendered batches. Lower is faster.</p>
                    <input id="animation-speed" type="range" min="0" max="100" step="5" @bind="_animationDelayMs" @bind:event="oninput"/>
                    <p>@_animationDelayMs ms</p>
                </div>
            </div>
        </details>

    </div>

    <div class="maze-grid" style="--cols:@_maze.Columns; --rows:@_maze.Rows;" @onmouseleave="@StopDragging" @onmouseup="@StopDragging">
        @for (int row = 0; row < _maze.Rows; row++)
        {
            @for (int column = 0; column < _maze.Columns; column++)
            {
                int r = row;
                int c = column;
                <div class="cell @GetCssForCell(r, c)"
                     @onmousedown="() => StartDragging(r, c)"
                     @onmouseover="() => ContinueDragging(r, c)"
                     @oncontextmenu:preventDefault="true">
                </div>
            }
        }
                </div>
    <p style="color:red;">@_errorMessage</p>

</div>

<div class="mobile-warning">
    <h3>Desktop Required</h3>
    <hr />
    <p>This demo was made for devices with mice or trackpads (laptops, PCs, etc).</p>
    <p>
        If you're using a touchscreen laptop, please connect a mouse or use the trackpad.
        If you're on a mobile device, please switch to a desktop.
    </p>
    <p>Sorry for the inconvenience!</p>
</div>

@code {

    MazeCell _activeMazeCell = MazeCell.Empty;

    Dictionary<(int, int), AlgorithmState> _algorithmState = new();
    CancellationTokenSource? _tokenSource;
    bool _isSolving = false;

    readonly BreadthFirstSearch _breadthFirstSearch = new();
    readonly RecursiveBacktrackGenerator _generator = new();

    Maze _maze = new();

    bool _isDragging = false;
    MazeCell _paintValue = MazeCell.Empty;

    string? _errorMessage;

    bool _skipAnimation = false;

    int _batchSize = 8;
    int _animationDelayMs = 20;
    
    public void StartDragging(int row, int col) {
        if (_isSolving) return;
        _paintValue = _activeMazeCell;
        if (ValidatePlacement()) {
            _maze.SetCell(row, col, _paintValue);
            _isDragging = _paintValue is MazeCell.Wall or MazeCell.Empty;
        }
    }

    public void ContinueDragging(int row, int col) {
        if (!_isDragging || _isSolving) return;
        _maze.SetCell(row, col, _paintValue);
    }

    void StopDragging() {
        _isDragging = false;
    }

    public string GetCssForCell(int row, int col) {
        string structureState = _maze.GetCell(row, col).ToString().ToLower();
        string algorithmClass = _algorithmState.TryGetValue((row, col), out var state) ? state.ToString().ToLower() : "";
        return $"{structureState} {algorithmClass}";
    }

    public void SetActiveCell(MazeCell cell) {
        _activeMazeCell = cell;
    }

    bool StartExists() => _maze.Cells.Any(c => c == MazeCell.Start);
    bool EndExists() => _maze.Cells.Any(c => c == MazeCell.End);

    private bool ValidatePlacement() {
        if ((_paintValue == MazeCell.Start && StartExists()) || (_paintValue == MazeCell.End && EndExists())) {
            _errorMessage = $"You can only have one {Enum.GetName(_paintValue)?.ToLower()} placed.";
            return false;
        }
        _errorMessage = "";
        return true;
    }

    private bool CanSolve() {
        if (!StartExists() || !EndExists()) {
            _errorMessage = "You must have a start and ending cell before attempting to solve.";
            return false;
        }
        _errorMessage = "";
        return true;
    }

    async Task StartSolve() {
        if (!CanSolve()) return;
        if(_tokenSource != null)
            await _tokenSource.CancelAsync();
        
        _tokenSource = new CancellationTokenSource();
        _algorithmState.Clear();
        _isSolving = true;
        bool pathFound = false;
        int count = 0;
        try {
            foreach (var step in _breadthFirstSearch.Solve(_maze, _tokenSource.Token)) {
                _algorithmState[(step.Row, step.Col)] = step.State;
                if (step.State == AlgorithmState.Path) pathFound = true;
                count++;
                if (!_skipAnimation && count % _batchSize == 0) {
                    StateHasChanged();
                    await Task.Delay(_animationDelayMs, _tokenSource.Token);
                }
            }
            if (!pathFound) {
                _errorMessage = "No path exists between Start and End.";
            }
        } catch (OperationCanceledException) { }
        finally {
            foreach (var key in _algorithmState.Keys.ToList()) {
                if (_algorithmState[key] == AlgorithmState.Frontier)
                    _algorithmState[key] = AlgorithmState.Visited;
            }
            _isSolving = false;
            _skipAnimation = false;
            
            StateHasChanged();
        }
    }

    void StopSolve() => _tokenSource?.Cancel();

    void SkipAnimation() => _skipAnimation = true;


    void GenerateMaze() {
        if (_isSolving) {
            _errorMessage = "Cannot generate a new maze while simulation is running. Stop first.";
            return;
        }
        _generator.Generate(_maze);
        _algorithmState.Clear();
        _errorMessage = "";
    }

    void Clear() {
        if (_isSolving) {
            _errorMessage = "Cannot clear maze while simulation is running. Stop first, then clear.";
            return;
        }
        _maze.Clear();
        _algorithmState.Clear();
    }
}
